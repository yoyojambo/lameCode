package ui

import (
	"fmt"
	"time"
	"lameCode/internal/platform/data"
)

// Simplified view types - only what the template needs beyond raw data
type ProfileView struct {
	User                 data.GetUserStatsRow
	CompletedChallenges  []data.GetUserCompletedChallengesWithDetailsRow
	RecentSubmissions    []data.GetUserRecentSubmissionsRow
	DifficultyBreakdown  []data.GetUserDifficultyBreakdownRow
	LanguageStats        []data.GetUserLanguageStatsRow
}

// Helper functions for the template
func formatMemberSince(timestamp int64) string {
	return time.Unix(timestamp, 0).Format("Jan 2, 2006")
}

func daysActive(createdAt int64) int64 {
	return (time.Now().Unix() - createdAt) / 86400
}

func successRate(accepted, total int64) string {
	if total == 0 {
		return "0.0%"
	}
	return fmt.Sprintf("%.1f%%", (float64(accepted)/float64(total))*100)
}

func langAcceptanceRate(accepted, total int64) string {
	if total == 0 {
		return "0%"
	}
	return fmt.Sprintf("%.0f%%", (float64(accepted)/float64(total))*100)
}

func relativeTime(timestamp int64) string {
	duration := time.Since(time.Unix(timestamp, 0))
	switch {
	case duration < time.Minute:
		return "just now"
	case duration < time.Hour:
		return fmt.Sprintf("%dm ago", int(duration.Minutes()))
	case duration < 24*time.Hour:
		return fmt.Sprintf("%dh ago", int(duration.Hours()))
	default:
		return fmt.Sprintf("%dd ago", int(duration.Hours()/24))
	}
}

func mostUsedLanguage(stats []data.GetUserLanguageStatsRow) string {
	if len(stats) == 0 {
		return "None"
	}
	return stats[0].Language
}

// Full page
templ ProfilePage(user UserData, profile ProfileView) {
	@Base(profile.User.Username + "'s Profile", user) {
		@ProfileContent(profile)
	}
}

// Main content (for HTMX swaps)
templ ProfileContent(profile ProfileView) {
	<div id="main" class="max-w-6xl mx-auto px-5 py-6 space-y-6">
		
		// User Header
		<div class="bg-base-800 border border-base-600 rounded-lg p-6">
			<div class="flex items-center gap-3">
				<h2 class="text-2xl font-bold text-base-50">{ profile.User.Username }</h2>
				if profile.User.IsAdmin == 1 {
					<span class="bg-accent-500 text-white text-xs font-semibold px-2 py-1 rounded">Admin</span>
				}
			</div>
			<p class="text-base-200 mt-1">
				Member since { formatMemberSince(profile.User.CreatedAt) }
				<span class="text-base-300 ml-2">({ fmt.Sprint(daysActive(profile.User.CreatedAt)) } days active)</span>
			</p>
		</div>

		// Stats Overview
		<div class="grid grid-cols-2 md:grid-cols-4 gap-4">
			@statCard(fmt.Sprint(profile.User.ChallengesCompleted), "Challenges Solved", "primary")
			@statCard(fmt.Sprint(profile.User.TotalSolutions), "Total Submissions", "info")
			@statCard(successRate(profile.User.AcceptedSolutions, profile.User.TotalSolutions), "Success Rate", "success")
			@statCard(mostUsedLanguage(profile.LanguageStats), "Favorite Language", "accent")
		</div>

		// Difficulty & Language Stats
		<div class="grid grid-cols-1 md:grid-cols-2 gap-4">
			// Difficulty Breakdown
			<div class="bg-base-800 border border-base-600 rounded-lg p-5">
				<h4 class="text-lg font-semibold text-base-50 mb-4">Difficulty Breakdown</h4>
				if len(profile.DifficultyBreakdown) > 0 {
					<div class="space-y-3">
						for _, d := range profile.DifficultyBreakdown {
							<div class="flex justify-between items-center py-2 border-b border-base-700 last:border-0">
								@difficultyBadge(d.Difficulty)
								<span class="text-base-100 text-sm">{ fmt.Sprint(d.CompletedCount) } solved</span>
							</div>
						}
					</div>
				} else {
					<p class="text-base-300 italic">No challenges completed yet.</p>
				}
			</div>

			// Language Stats
			<div class="bg-base-800 border border-base-600 rounded-lg p-5">
				<h4 class="text-lg font-semibold text-base-50 mb-4">Language Usage</h4>
				if len(profile.LanguageStats) > 0 {
					<div class="space-y-3">
						for _, lang := range profile.LanguageStats {
							<div class="py-2 border-b border-base-700 last:border-0">
								<div class="flex justify-between items-center">
									<span class="text-base-50 font-medium">{ lang.Language }</span>
									<span class="text-base-200 text-sm">
										{ fmt.Sprint(lang.SubmissionCount) } submissions
									</span>
								</div>
								<div class="text-base-300 text-xs mt-1">
									{ langAcceptanceRate(lang.AcceptedCount, lang.SubmissionCount) } accepted
								</div>
							</div>
						}
					</div>
				} else {
					<p class="text-base-300 italic">No submissions yet.</p>
				}
			</div>
		</div>

		// Completed Challenges
		<div class="bg-base-800 border border-base-600 rounded-lg p-5">
			<h4 class="text-lg font-semibold text-base-50 mb-4">
				Completed Challenges
				if len(profile.CompletedChallenges) > 0 {
					<span class="text-primary-400 ml-1">({ fmt.Sprint(len(profile.CompletedChallenges)) })</span>
				}
			</h4>
			if len(profile.CompletedChallenges) > 0 {
				<div class="overflow-x-auto">
					<table class="w-full text-left text-sm">
						<thead>
							<tr class="border-b-2 border-primary-700 bg-primary-900/30">
								<th class="py-3 px-3 text-primary-100 font-semibold">Challenge</th>
								<th class="py-3 px-3 text-primary-100 font-semibold">Difficulty</th>
								<th class="py-3 px-3 text-primary-100 font-semibold">Language</th>
								<th class="py-3 px-3 text-primary-100 font-semibold">Completed</th>
								<th class="py-3 px-3 text-primary-100 font-semibold">Runtime</th>
								<th class="py-3 px-3 text-primary-100 font-semibold">Action</th>
							</tr>
						</thead>
						<tbody>
							for _, c := range profile.CompletedChallenges {
								<tr class="border-b border-base-700 hover:bg-base-700/50">
									<td class="py-3 px-3">
										<a href={ templ.URL(fmt.Sprintf("/problem/%d", c.ChallengeID)) } 
										   class="text-primary-400 hover:text-primary-300 font-medium">
											{ c.Title }
										</a>
									</td>
									<td class="py-3 px-3">
										@difficultyBadge(c.Difficulty)
									</td>
									<td class="py-3 px-3 text-base-100">{ c.Language }</td>
									<td class="py-3 px-3 text-base-200">{ relativeTime(c.CompletedAt) }</td>
									<td class="py-3 px-3 text-base-200">{ c.RuntimeInfo.String }</td>
									<td class="py-3 px-3">
										<a href={ templ.URL(fmt.Sprintf("/problem/%d", c.ChallengeID)) }
										   class="bg-primary-600 hover:bg-primary-500 text-white text-xs font-medium px-3 py-1.5 rounded">
											View
										</a>
									</td>
								</tr>
							}
						</tbody>
					</table>
				</div>
			} else {
				<p class="text-base-300 italic">
					No challenges completed yet. 
					<a href="/" hx-boost="true" hx-swap="outerHTML" hx-target="#main" 
					   class="text-primary-400 hover:text-primary-300 ml-1">
						Start solving!
					</a>
				</p>
			}
		</div>

		// Recent Submissions
		<div class="bg-base-800 border border-base-600 rounded-lg p-5">
			<h4 class="text-lg font-semibold text-base-50 mb-4">
				Recent Submissions
				if len(profile.RecentSubmissions) > 0 {
					<span class="text-primary-400 ml-1">({ fmt.Sprint(len(profile.RecentSubmissions)) })</span>
				}
			</h4>
			if len(profile.RecentSubmissions) > 0 {
				<div class="overflow-x-auto">
					<table class="w-full text-left text-sm">
						<thead>
							<tr class="border-b-2 border-primary-700 bg-primary-900/30">
								<th class="py-3 px-3 text-primary-100 font-semibold">Challenge</th>
								<th class="py-3 px-3 text-primary-100 font-semibold">Language</th>
								<th class="py-3 px-3 text-primary-100 font-semibold">Status</th>
								<th class="py-3 px-3 text-primary-100 font-semibold">Submitted</th>
								<th class="py-3 px-3 text-primary-100 font-semibold">Runtime</th>
							</tr>
						</thead>
						<tbody>
							for _, s := range profile.RecentSubmissions {
								<tr class="border-b border-base-700 hover:bg-base-700/50">
									<td class="py-3 px-3">
										<a href={ templ.URL(fmt.Sprintf("/problem/%d", s.ChallengeID)) }
										   class="text-primary-400 hover:text-primary-300 font-medium">
											{ s.ChallengeTitle }
										</a>
									</td>
									<td class="py-3 px-3 text-base-100">{ s.Language }</td>
									<td class="py-3 px-3">
										@statusBadge(s.Status)
									</td>
									<td class="py-3 px-3 text-base-200">{ relativeTime(s.CreatedAt) }</td>
									<td class="py-3 px-3 text-base-200">{ s.RuntimeInfo.String }</td>
								</tr>
							}
						</tbody>
					</table>
				</div>
			} else {
				<p class="text-base-300 italic">No submissions yet.</p>
			}
		</div>
	</div>
}

// Reusable stat card component
templ statCard(value string, label string, color string) {
	<div class="bg-base-800 border border-base-600 rounded-lg p-4 text-center">
		<h4 class={
			"text-2xl font-bold",
			templ.KV("text-primary-400", color == "primary"),
			templ.KV("text-info-400", color == "info"),
			templ.KV("text-success", color == "success"),
			templ.KV("text-accent-400", color == "accent"),
		}>
			{ value }
		</h4>
		<p class="text-base-200 text-sm mt-1">{ label }</p>
	</div>
}

// Difficulty badge component
templ difficultyBadge(difficulty int64) {
	switch difficulty {
		case 1:
			<span class="inline-block bg-success text-white text-xs font-semibold px-2 py-1 rounded">Easy</span>
		case 2:
			<span class="inline-block bg-warning text-base-900 text-xs font-semibold px-2 py-1 rounded">Medium</span>
		case 3:
			<span class="inline-block bg-error text-white text-xs font-semibold px-2 py-1 rounded">Hard</span>
		default:
			<span class="inline-block bg-base-500 text-base-100 text-xs font-semibold px-2 py-1 rounded">Untagged</span>
	}
}

// Status badge component
templ statusBadge(status string) {
	switch status {
		case "accepted":
			<span class="inline-block bg-success/20 text-green-300 border border-success/40 text-xs font-semibold px-2 py-1 rounded">
				Accepted
			</span>
		case "wrong_answer":
			<span class="inline-block bg-error/20 text-red-300 border border-error/40 text-xs font-semibold px-2 py-1 rounded">
				Wrong Answer
			</span>
		case "runtime_error":
			<span class="inline-block bg-accent-500/20 text-orange-300 border border-accent-500/40 text-xs font-semibold px-2 py-1 rounded">
				Runtime Error
			</span>
		case "pending":
			<span class="inline-block bg-base-500/20 text-base-200 border border-base-400/40 text-xs font-semibold px-2 py-1 rounded">
				Pending
			</span>
		default:
			<span class="inline-block bg-base-500/20 text-base-200 border border-base-400/40 text-xs font-semibold px-2 py-1 rounded">
				{ status }
			</span>
	}
}
