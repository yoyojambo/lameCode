package ui

templ Navbar(user UserData) {
	<div id="navbar" class="navbar" hx-boost="true" hx-swap="outerHTML" hx-target="#main">
		<div>
			if user.IsAdmin {
				<a href="/admin#"><b>Dashboard</b></a>
			}
			<a href="/#">Problems</a>
			<a href="/settings#">Settings</a>
			if user.LoggedIn {
				<a href="/logout#">Logout</a>
			}
		</div>
		<div style="display: flex; align-items: center">
			if user.LoggedIn {
				<a title="View your profile" href={ templ.URL("/user/" + user.Username) }>
					{ user.Username }
				</a>
			} else {
				<a title="Login or register" href="/login">Login</a>
				<p style="font-weight: bold; font-style: italic; color: #888">Anonymous</p>
			}
		</div>
	</div>
}
