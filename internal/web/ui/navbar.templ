package ui

templ Navbar(user UserData) {
	<nav id="navbar" 
		class="flex justify-between items-center mx-auto mt-2 mb-4 bg-base-800 border border-base-600 rounded-lg px-4 py-2 max-w-[55%]"
		hx-boost="true" hx-swap="outerHTML" hx-target="#main">
		<div class="flex items-center space-x-6">
			if user.IsAdmin {
				<a href="/admin#" class="font-semibold text-primary-400 hover:text-primary-300">Dashboard</a>
			}
			<a href="/#" class="text-base-100 hover:text-primary-400">Problems</a>
			<a href="/settings#" class="text-base-100 hover:text-primary-400">Settings</a>
			if user.LoggedIn {
				<a href="/logout#" class="text-base-100 hover:text-primary-400">Logout</a>
			}
		</div>
		<div class="flex items-center space-x-3">
			if user.LoggedIn {
				<a title="View your profile" 
				   href={ templ.URL("/user/" + user.Username) } 
				   class="text-primary-400 font-medium hover:text-primary-300">{ user.Username }</a>
			} else {
				<a title="Login or register" href="/login" class="text-info-400 hover:text-info-300">Login</a>
				<span class="italic text-base-300">Anonymous</span>
			}
		</div>
	</nav>
}
