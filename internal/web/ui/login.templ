package ui

// FlashMessage holds data for flash notifications
type FlashMessage struct {
	Type    string // "error" or "success"
	Message string
}

// Full page with layout
templ LoginPage(user UserData, flash FlashMessage) {
	@Base("Login", user) {
		@LoginContent(flash)
	}
}

// Main content (for HX-Request swaps)
templ LoginContent(flash FlashMessage) {
	<div id="main" class="max-w-md mx-auto mt-24 px-4">
		<div class="bg-base-800 border border-base-600 rounded-lg p-8 shadow-lg">
			
			@FlashMessagePartial(flash)
			
			// Login Panel
			<div id="login-panel" class="auth-panel">
				<h2 class="text-3xl font-semibold text-base-50 text-center mb-6">Login</h2>

				<form
					hx-post="/login"
					hx-boost="true"
					hx-target="#flash"
					hx-swap="outerHTML"
					class="flex flex-col"
				>
					<label for="login-username" class="text-base-100 font-medium mb-1">Username</label>
					<input 
						type="text" 
						id="login-username" 
						name="username" 
						required
						class="w-full bg-base-700 border border-base-500 rounded px-3 py-2 text-base-50 placeholder-base-400 focus:border-primary-500 focus:ring-1 focus:ring-primary-500/30 outline-none mb-4"
					/>

					<label for="login-password" class="text-base-100 font-medium mb-1">Password</label>
					<input 
						type="password" 
						id="login-password" 
						name="password" 
						required
						class="w-full bg-base-700 border border-base-500 rounded px-3 py-2 text-base-50 placeholder-base-400 focus:border-primary-500 focus:ring-1 focus:ring-primary-500/30 outline-none mb-6"
					/>

					<button 
						type="submit"
						class="w-full bg-primary-600 hover:bg-primary-500 text-white font-semibold py-2.5 rounded transition-colors"
					>
						Log In
					</button>
				</form>

				<p class="text-center text-base-200 mt-6">
					Don't have an account?
					<a href="#" id="show-register" class="text-primary-400 hover:text-primary-300 ml-1">
						Register here
					</a>
				</p>
			</div>

			// Register Panel
			<div id="register-panel" class="auth-panel hidden">
				<h2 class="text-3xl font-semibold text-base-50 text-center mb-6">Register</h2>

				<form
					hx-post="/register"
					hx-boost="true"
					hx-target="#flash"
					hx-swap="outerHTML"
					class="flex flex-col"
				>
					<label for="reg-username" class="text-base-100 font-medium mb-1">Choose a Username</label>
					<input 
						type="text" 
						id="reg-username" 
						name="username" 
						required
						class="w-full bg-base-700 border border-base-500 rounded px-3 py-2 text-base-50 placeholder-base-400 focus:border-primary-500 focus:ring-1 focus:ring-primary-500/30 outline-none mb-4"
					/>

					<label for="reg-password" class="text-base-100 font-medium mb-1">Password</label>
					<input 
						type="password" 
						id="reg-password" 
						name="password" 
						required
						class="w-full bg-base-700 border border-base-500 rounded px-3 py-2 text-base-50 placeholder-base-400 focus:border-primary-500 focus:ring-1 focus:ring-primary-500/30 outline-none mb-4"
					/>

					<label for="reg-confirm" class="text-base-100 font-medium mb-1">Confirm Password</label>
					<input 
						type="password" 
						id="reg-confirm" 
						name="confirm_password" 
						required
						class="w-full bg-base-700 border border-base-500 rounded px-3 py-2 text-base-50 placeholder-base-400 focus:border-primary-500 focus:ring-1 focus:ring-primary-500/30 outline-none mb-6"
					/>

					<button 
						type="submit"
						class="w-full bg-primary-600 hover:bg-primary-500 text-white font-semibold py-2.5 rounded transition-colors"
					>
						Register
					</button>
				</form>

				<p class="text-center text-base-200 mt-6">
					Already have an account?
					<a href="#" id="show-login" class="text-primary-400 hover:text-primary-300 ml-1">
						Log in here
					</a>
				</p>
			</div>
		</div>
	</div>

	// Panel toggle script
	<script>
		document.getElementById('show-register')?.addEventListener('click', (e) => {
			e.preventDefault();
			document.getElementById('login-panel').classList.add('hidden');
			document.getElementById('register-panel').classList.remove('hidden');
		});
		document.getElementById('show-login')?.addEventListener('click', (e) => {
			e.preventDefault();
			document.getElementById('register-panel').classList.add('hidden');
			document.getElementById('login-panel').classList.remove('hidden');
		});
	</script>
}

// Flash message partial (swappable via HTMX)
templ FlashMessagePartial(flash FlashMessage) {
	if flash.Message != "" {
		<div 
			id="flash" 
			class={
				"mb-6 px-4 py-3 rounded text-center font-medium",
				templ.KV("bg-error/20 text-red-300 border border-error/40", flash.Type == "error"),
				templ.KV("bg-success/20 text-green-300 border border-success/40", flash.Type == "success"),
			}
		>
			{ flash.Message }
		</div>
	} else {
		<div id="flash"></div>
	}
}
