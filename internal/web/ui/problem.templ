package ui

import (
	"fmt"
	"html/template"
	"lameCode/internal/platform/data"
	"lameCode/internal/platform/judge"

	"github.com/gomarkdown/markdown"
	"github.com/gomarkdown/markdown/html"
	"github.com/gomarkdown/markdown/parser"
)

// Local representation of a challenge.
// Necessary so Gin renders the HTML description correctly.
type ApiChallenge struct {
	Id          int64
	Title       string
	Difficulty  int64
	Description template.HTML
}

// ProblemPage is the full-page for problems, including the editor,
// submission/test buttons and results.
templ ProblemPage(user UserData, challenge data.Challenge, languages []judge.LanguageOption) {
	@Base(challenge.Title, user) {
		@ProblemEditor(user, challenge, languages)
	}
}

// Straight up from https://github.com/gomarkdown/markdown
// Thanks for the library.
func mdToHTML(md string) string {
	md_bs := []byte(md)
	// create markdown parser with extensions
	extensions := parser.CommonExtensions | parser.AutoHeadingIDs | parser.NoEmptyLineBeforeBlock
	p := parser.NewWithExtensions(extensions)
	doc := p.Parse(md_bs)

	// create HTML renderer with extensions
	htmlFlags := html.CommonFlags | html.HrefTargetBlank
	opts := html.RendererOptions{Flags: htmlFlags}
	renderer := html.NewRenderer(opts)

	return string(markdown.Render(doc, renderer))
}

// ProblemEditor is the partial within ProblemPage, including the editor,
// submission/test buttons and results.
templ ProblemEditor(user UserData, challenge data.Challenge, languages []judge.LanguageOption) {
	<title>{ challenge.Title }</title>
	<div id="main" class="max-w-6xl mx-auto px-5 py-6">
		<div class="grid grid-cols-1 md:grid-cols-2 gap-4">
			
			// Left Column
			<div class="bg-base-800 border border-base-600 rounded-lg p-5">
				
				<h3 class="text-xl font-semibold text-base-50 mb-2">{ challenge.Title }</h3>
				<div class="flex justify-start items-center space-x-2 mt-4">
				
					switch challenge.Difficulty {
					case 1:
						<span class="inline-block bg-success text-white text-sm px-2 py-1 rounded mb-2">Easy</span>
					case 2:
						<span class="inline-block bg-warning text-base-900 text-sm px-2 py-1 rounded mb-2">Medium</span>
					case 3:
						<span class="inline-block bg-error text-white text-sm px-2 py-1 rounded mb-2">Hard</span>
					default:
						<span class="inline-block bg-base-500 text-base-100 text-sm px-2 py-1 rounded mb-2">Not tagged</span>
					}
					
					if user.IsAdmin {
						<a class="bg-accent-600 hover:bg-accent-500 text-white font-medium px-4 py-1.5 rounded" href={fmt.Sprint("/admin/problems/", challenge.ID, "/edit")}> Edit</a>
					}
					
				</div>

				<div id="problem-description" class="prose prose-invert max-w-none mt-4 text-base-100">
					@templ.Raw(mdToHTML(challenge.Description))
				</div>

			</div>

			// Right Column
			<div class="bg-base-800 border border-base-600 rounded-lg p-5 flex flex-col">
				<div class="flex items-center justify-between mb-3">
					<select id="language-select" name="language" 
						class="bg-base-700 border border-base-500 rounded px-2 py-1 text-base-100 focus:border-primary-500 focus:ring-1 focus:ring-primary-500/30 outline-none">
						for _, lang := range languages {
							<option value={ lang.Lang }>{ fmt.Sprintf("%s (%s)", lang.PrettyName, lang.Compiler) }</option>
						}
					</select>
					<button id="reset-button" type="button" 
						class="text-sm text-base-300 hover:text-primary-400">
						Reset
					</button>
				</div>

				<div id="code-editor" class="flex-1 border border-base-600 rounded min-h-[300px] bg-base-900"></div>
				<textarea id="code-input" name="code" hidden></textarea>

				<div class="flex justify-end items-center space-x-2 mt-4">
					<button
						disabled?={ challenge.TestCount < 1 }
						id="test-button"
						class="bg-base-700 hover:bg-base-600 text-base-100 font-medium px-4 py-1.5 rounded border border-base-500 disabled:opacity-50 disabled:cursor-not-allowed"
						hx-post={ fmt.Sprintf("/judge/test/%d", challenge.ID) }
						hx-include="#code-input,#language-select"
						hx-target="#results"
						hx-swap="innerHTML"
						hx-indicator=".spinner"
						type="button"
						onclick="document.getElementById('code-input').value = window.editor.getValue()"
					>Test</button>

					<button
						disabled?={ challenge.TestCount < 1 }
						id="submit-button"
						class="bg-primary-600 hover:bg-primary-500 text-white font-medium px-4 py-1.5 rounded disabled:opacity-50 disabled:cursor-not-allowed"
						hx-post={ fmt.Sprintf("/judge/submit/%d", challenge.ID) }
						hx-include="#code-input,#language-select"
						hx-target="#results"
						hx-swap="innerHTML"
						hx-indicator=".spinner"
						type="button"
						onclick="document.getElementById('code-input').value = window.editor.getValue()"
					>Submit</button>

					<div class="spinner hidden text-primary-400">⏳</div>
				</div>

				<div id="results" class="mt-4 h-48 border border-base-600 bg-base-900 overflow-auto rounded p-3 text-sm text-base-200">
					No results yet.
				</div>
			</div>
		</div>
	</div>
}

func countPasses(results []judge.Result) int {
	var count int
	for _, r := range results {
		if r.Pass {
			count++
		}
	}

	return count
}

templ ResultTable(submission Submission, results []judge.Result) {
	{{
		passes := countPasses(results)
		result_class := "success"
		if passes != len(results) {
			result_class = "error"
		}
	}}
	if passes != len(results) {
		<h2>Solution fails.</h2>
	} else {
		<h2>Solution passes!</h2>
	}
	<span class={"font-bold text-" + result_class}>{passes}/{len(results)} tests passed.</span>
	<table class="w-full mt-4 text-left text-sm">
		<thead>
			<tr class="border-b border-primary-700 bg-primary-900/30">
				for _, col := range []string{"Name", "Pass", "Runtime (ms)", "Max Memory (Bytes)"} {
					<th class="py-2 px-2 text-primary-200 font-semibold">{col}</th>
				}
			</tr>
		</thead>
		<tbody>
			for _, r := range results {
				<tr class="border-b border-base-700 hover:bg-base-700/50">
					<td class="py-2 px-2 text-base-100">{ r.Name }</td>
					<td class="py-2 px-2">
						if r.Pass {
							<span class="font-bold text-success">Pass</span>
						} else {
							<span class="font-bold text-error">Fail</span>
						}
					</td>
					<td class="py-2 px-2 text-base-200">{ r.Runtime }</td>
					<td class="py-2 px-2 text-base-200">{ r.MaxMemUsed }</td>
				</tr>
			}
			if len(results) == 0 {
				<tr>
					<td colspan="4" class="py-4 text-center italic text-base-400">No results to display.</td>
				</tr>
			}
		</tbody>
	</table>

	<div class="htmx-indicator flex justify-center mt-4">
		<div class="w-8 h-8 border-4 border-primary-800 border-t-primary-400 rounded-full animate-spin"></div>
	</div>
}

templ CompilerMessage(msg string) {
	<p class="text-red-600 font-medium">Compiler Error! See below:</p>
	<pre class="mt-2 p-3 bg-base-900 border border-base-600 rounded text-sm overflow-auto text-base-100"
		>{ msg }</pre>
}
