package ui

import (
	"fmt"
)

// Full page with layout
templ ProblemsPage(user UserData, challengesView ChallengePage) {
	@Base("", user) {
		@ProblemsContent(challengesView)
	}
}

// Main content block (for HX-Request swaps)
templ ProblemsContent(challengesView ChallengePage) {
	if challengesView.CurrentPage <= 1 {
		<title>{ "Home" }</title>
	} else {
		<title>{ fmt.Sprint("Home - Page ", challengesView.CurrentPage) }</title>
	}
	<div id="main" class="max-w-5xl mx-auto px-5 py-6">
		<h3 class="w-full bg-base-700 border border-base-200 p-2 rounded-lg text-2xl font-semibold text-base-50 text-center mb-2">Most Popular Challenges</h3>
		
		if len(challengesView.Challenges) > 0 {
			@ProblemsList(challengesView)
		} else if challengesView.CurrentPage == 0 {
			// Initial load trigger
			<div id="challenges" hx-get="/problemlist?page=1" hx-trigger="load" hx-swap="outerHTML"></div>
		} else {
			// Empty state
			<div class="bg-base-700 border border-base-200 rounded-lg p-8 text-center">
				<p class="text-base-200">No challenges available yet.</p>
			</div>
		}
	</div>
}

// Challenge list with pagination (swappable via HTMX)
templ ProblemsList(challengesView ChallengePage) {
	<div id="challenges" class="bg-base-700 border border-base-800 rounded-lg p-5">
		// Pagination controls - top
		<div class="flex gap-2 mb-4">
			<button
				if !challengesView.HasPrev {
					disabled
				}
				hx-get={ fmt.Sprintf("/problemlist?page=%d", challengesView.PrevPage) }
				hx-target="#challenges"
				hx-swap="outerHTML"
				class="bg-base-700 hover:bg-base-600 text-base-50 font-medium px-4 py-2 rounded border border-base-500 disabled:opacity-50 disabled:cursor-not-allowed"
			>
				&larr; Back
			</button>
			
			<button
				if !challengesView.HasNext {
					disabled
				}
				hx-get={ fmt.Sprintf("/problemlist?page=%d", challengesView.NextPage) }
				hx-target="#challenges"
				hx-swap="outerHTML"
				class="bg-base-700 hover:bg-base-600 text-base-50 font-medium px-4 py-2 rounded border border-base-500 disabled:opacity-50 disabled:cursor-not-allowed"
			>
				Next &rarr;
			</button>
			
			<span class="ml-auto text-base-50 text-sm self-center">
				Page { fmt.Sprint(challengesView.CurrentPage) }
			</span>
		</div>

		// Challenge table
		<div class="overflow-x-auto">
			<table 
				class="w-full text-left"
				hx-boost="true"
				hx-target="#main"
				hx-swap="outerHTML show:window:top"
			>
				<thead>
					<tr class="border-b-2 border-primary-700 bg-primary-900/30">
						<th class="w-[60%] py-3 px-4 text-primary-100 font-semibold">Challenge</th>
						<th class="py-3 px-4 text-primary-100 font-semibold">Difficulty</th>
						<th class="py-3 px-4 text-primary-100 font-semibold">Tests</th>
					</tr>
				</thead>
				<tbody>
					for _, challenge := range challengesView.Challenges {
						<tr class="border-b border-base-700 hover:bg-base-700/50 transition-colors">
							<td class="py-0">
								<a 
									href={ templ.URL(fmt.Sprintf("/problem/%d#", challenge.ID)) }
									class="block py-3 px-4 text-base-50 font-medium hover:text-primary-400"
								>
									{ challenge.Title }
								</a>
							</td>
							<td class="py-3 px-4">
								switch challenge.Difficulty {
									case 1:
										<span class="inline-block bg-success text-white text-xs font-semibold px-2 py-1 rounded">Easy</span>
									case 2:
										<span class="inline-block bg-warning text-base-900 text-xs font-semibold px-2 py-1 rounded">Medium</span>
									case 3:
										<span class="inline-block bg-error text-white text-xs font-semibold px-2 py-1 rounded">Hard</span>
									default:
										<span class="inline-block bg-base-500 text-base-100 text-xs font-semibold px-2 py-1 rounded">Not tagged</span>
								}
							</td>
							<td class="py-3 px-4 text-base-100">
								{ fmt.Sprint(challenge.TestCount) } tests
							</td>
						</tr>
					}
					if len(challengesView.Challenges) == 0 {
						<tr>
							<td colspan="3" class="py-8 text-center text-base-200">
								No challenges available.
							</td>
						</tr>
					}
				</tbody>
			</table>
		</div>
	</div>
}
